    "typecheck": "tsc --noEmit",
    "test": "node --import ../../../WWCP_Node/Frontend/test/resolve.ts --test \"src/**/*.test.ts\"",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "css-loader": "^7.1.5",
