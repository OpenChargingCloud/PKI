{
  "name": "pki-frontend",
  "version": "0.1.0",
  "description": "The web interface of the OpenChargingCloud PKI: HTML, SCSS and TypeScript bundled by webpack, served by the Hermod HTTP/1.1 server.",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
