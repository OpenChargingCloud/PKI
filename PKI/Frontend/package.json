    "mini-css-extract-plugin": "^2.10.2",
    "sass": "^1.105.1",
    "sass-loader": "^17.0.1",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "lit-html": "3.3.3"
  }
